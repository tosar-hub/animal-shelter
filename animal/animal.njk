---
pagination:
    data: animals
    size: 1
    alias: animal
permalink: "animal/{{ animal.id }}/index.html"
layout: base.njk
---
<div class="row">
    <div class="col-md-6">
        <img src="{{ animal.photo_url or 'https://via.placeholder.com/600x400' }}" class="img-fluid rounded" alt="{{ animal.name }}">
    </div>
    <div class="col-md-6">
        <h2>{{ animal.name }}</h2>
        <p><strong>Вид:</strong> {{ 'Кошка' if animal.species == 'cat' else 'Собака' }}</p>
        <p><strong>Порода:</strong> {{ animal.breed }}</p>
        <p><strong>Возраст:</strong> {{ animal.age_months }} мес.</p>
        <p><strong>Пол:</strong>
            {% if animal.gender == 'male' %}
                Мальчик
            {% elif animal.gender == 'female' %}
                Девочка
            {% else %}
                Неизвестно
            {% endif %}
        </p>
        <p><strong>Цвет:</strong> {{ animal.color or 'Не указан' }}</p>
        <p><strong>Описание:</strong> {{ animal.description }}</p>
        <a href="{{ '/' | url }}" class="btn btn-primary">← Назад к списку</a>
    </div>
</div>